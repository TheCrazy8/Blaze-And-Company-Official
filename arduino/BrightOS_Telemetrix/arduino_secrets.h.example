/*
 * Arduino Secrets Configuration
 * 
 * This file should contain your WiFi credentials.
 * 
 * IMPORTANT SECURITY NOTES:
 * - Keep this file private and never commit it to version control
 * - Add arduino_secrets.h to .gitignore
 * - Only use this on trusted networks
 * 
 * Instructions:
 * 1. Copy this file and rename it to "arduino_secrets.h" (without .example)
 * 2. Replace "your_network_name" with your WiFi network SSID
 * 3. Replace "your_network_password" with your WiFi password
 * 4. Save the file
 * 
 * Example:
 *   #define SECRET_SSID "MyHomeNetwork"
 *   #define SECRET_PASS "MySecurePassword123"
 */

#define SECRET_SSID "your_network_name"
#define SECRET_PASS "your_network_password"
